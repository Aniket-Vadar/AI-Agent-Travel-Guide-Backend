# ============================================================
#  AI Travel Planner - environment configuration
#  Copy to .env and fill in the values you need.
# ============================================================

# ---------- Application ----------
APP_ENV=development                 # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Comma separated. Use explicit origins in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173
# Optional: when set, every /api/v1 request must send `X-API-Key: <value>`
API_KEY=

# ---------- Google Gemini (required for the agents) ----------
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_TEMPERATURE=0.6
GEMINI_MAX_OUTPUT_TOKENS=8192

# ---------- LangSmith tracing ----------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-travel-planner
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------- Data providers (all free / keyless) ----------
WIKIPEDIA_LANG=en
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Nominatim's usage policy requires a real contact. The email is sent as a query
# parameter; the User-Agent header carries the URL (Nominatim 403s on emails in it).
CONTACT_EMAIL=you@example.com
CONTACT_URL=https://github.com/ai-travel-planner
HTTP_TIMEOUT_SECONDS=25

# ---------- Persistence ----------
DATABASE_URL=sqlite+aiosqlite:///./data/travel.db
CACHE_TTL_SECONDS=86400

# ---------- Rate Limiting & Anti-Abuse Protection ----------
# Set to 'false' or '0' to disable all IP rate limiting & abuse tracking
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=15/minute
RATE_LIMIT_PDF=6/minute
RATE_LIMIT_AUDIO=6/minute
RATE_LIMIT_GLOBAL=60/minute

# ---------- Booking ----------
# Simulated inventory. Set to a real provider adapter in production.
BOOKING_PROVIDER=simulated
BOOKING_CURRENCY=INR
